# The daemon's user unit. Installed by infra/apply.sh; NOT enabled by default.
# Installation composes operator-owned authority but does not decide when the
# daemon runs. Machine configuration lives in the repository per ADR-0001.
[Unit]
Description=Mastra CC desktop daemon

[Service]
Type=simple
ExecStart=/usr/bin/env node %h/.local/lib/mastra-cc/daemon/main.mjs --backend cdp --permit gmail --grants %h/.config/mastra-cc/gmail-grants.json --capabilities %h/.config/mastra-cc/gmail-capabilities.json --audit %h/.local/state/mastra-cc/audit.jsonl
Restart=on-failure

[Install]
WantedBy=default.target
