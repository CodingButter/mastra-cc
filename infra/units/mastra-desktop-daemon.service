# The daemon's user unit. Installed by infra/apply.sh; NOT enabled by default in
# M1 - the daemon it points at ships in Phase 3, and enabling is a later
# milestone's decision. Installed early because ADR-0001 requires machine
# configuration to live in the repository from commit one.
[Unit]
Description=Mastra CC desktop daemon

[Service]
Type=simple
ExecStart=/usr/bin/env node %h/.local/lib/mastra-cc/daemon/main.mjs --backend cdp --permit gmail --grants %h/.config/mastra-cc/gmail-grants.json --capabilities %h/.config/mastra-cc/gmail-capabilities.json --audit %h/.local/state/mastra-cc/audit.jsonl
Restart=on-failure

[Install]
WantedBy=default.target
